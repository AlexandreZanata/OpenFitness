# NutriOffline production environment (copy to .env or export before start)
#
# Fine-tuned model (Phase 5 + 6)
export NUTRI_ADAPTER=nutri-qwen25-3b-v1
export NUTRI_GGUF_QUANT=q4_k_m
export NUTRI_MODEL_NAME=nutri-qwen25-3b-v1-q4_k_m
#
# Embedding — keep bge-m3 until index rebuilt with another model (see embedder A/B report)
export NUTRI_EMBED_MODEL=BAAI/bge-m3
export NUTRI_EMBED_DIM=1024
#
# Optional faster LLM (after export): export NUTRI_GGUF_QUANT=q3_k_m
#
# App
export HF_HOME="$(pwd)/models/base"
export NUTRI_APP_PORT=8090
export NUTRI_INFERENCE_PORT=8080
